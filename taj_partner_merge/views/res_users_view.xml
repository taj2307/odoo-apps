<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_partner_merge" model="ir.ui.view">
        <field name="name">res.users.form.partner.merge</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="Partner Management">
                    <field name="can_merge_partners" string="Can Merge Partners"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
