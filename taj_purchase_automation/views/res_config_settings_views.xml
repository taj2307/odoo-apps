<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_po_automation" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.po.automation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='matrix_setting_container']" position="after">
                <block title="Purchase Order Automation">
                    <setting id="po_auto_validate_receipt_setting"
                             help="Automatically validate incoming shipments when a purchase order is confirmed">
                        <field name="po_auto_validate_receipt"/>
                    </setting>
                    <setting id="po_auto_create_bill_setting"
                             help="Automatically create a draft vendor bill when a purchase order is confirmed">
                        <field name="po_auto_create_bill"/>
                    </setting>
                    <setting id="po_auto_post_bill_setting"
                             help="Automatically post the vendor bill after creation">
                        <field name="po_auto_post_bill"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
