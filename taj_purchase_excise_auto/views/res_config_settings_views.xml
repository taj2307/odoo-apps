<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_excise" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.excise</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='matrix_setting_container']" position="after">
                <block title="Excise Duty">
                    <setting id="excise_product_setting"
                             help="Service product used for the automatic excise duty line">
                        <field name="excise_product_id"/>
                    </setting>
                    <setting id="excise_rate_setting"
                             help="Duty charged per unit of volume. Zero means use the excise product's price">
                        <field name="excise_rate"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
